# CatalogFlow never requires credentials for preview mode.
# Add values only in your local .env or operating-system credential store.

# Optional: official CJ API integration
CJ_API_KEY=

# Optional: WooCommerce REST integration. Never use an administrator password.
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Optional: Codex CLI listing generator
CATALOGFLOW_CODEX_COMMAND=
CATALOGFLOW_CODEX_MODEL=

# Optional: Claude Code CLI listing generator
CATALOGFLOW_CLAUDE_COMMAND=
CATALOGFLOW_CLAUDE_MODEL=
